# ============ 必配密钥(部署时生成,勿提交真实值) ============
# openssl rand -hex 32 生成

DATABASE_USER=tg_platform
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SCHEMA=fba

REDIS_PASSWORD=CHANGE_ME

# FBA JWT/系统密钥
TOKEN_SECRET_KEY=CHANGE_ME

# runtime session 信封加密 KEK(base64 32B,见 runtime/account/envelope.py)
SESSION_KEK=CHANGE_ME
# Worker 运行面服务凭证(control-api 与 tg-runtime-worker 必须同值;生成:openssl rand -hex 32)
RUNTIME_WORKER_TOKEN=CHANGE_ME

# LangBot HTTP Bot 入站/出站 HMAC
LANGBOT_IMAGE=rockchin/langbot:v4.6.5
HTTP_BOT_INBOUND_SECRET=CHANGE_ME
HTTP_BOT_OUTBOUND_SECRET=CHANGE_ME
# {binding_uuid} 来自 POST /api/v1/tg/ai/bindings 返回的 uuid
HTTP_BOT_CALLBACK_URL=http://control-api:8000/api/v1/tg/internal/ai/langbot/{binding_uuid}/callback

# MinIO(profile: object-storage)
MINIO_ROOT_USER=tg_platform
MINIO_ROOT_PASSWORD=CHANGE_ME

# ============ FBA .env 兼容项(control-api/task-worker/scheduler env_file 读取) ============
ENVIRONMENT=prod
DATABASE_TYPE=postgresql
DATABASE_HOST=postgres
DATABASE_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
CELERY_BROKER=redis
CELERY_BROKER_REDIS_DATABASE=1
OAUTH2_GITHUB_CLIENT_ID=disabled
OAUTH2_GITHUB_CLIENT_SECRET=disabled
OAUTH2_GOOGLE_CLIENT_ID=disabled
OAUTH2_GOOGLE_CLIENT_SECRET=disabled
EMAIL_USERNAME=
EMAIL_PASSWORD=
TG_RUNTIME_DIR=/srv/telegram-runtime
TG_RUNTIME_PYTHON=python3
TG_IMPORT_STORAGE_DIR=/var/lib/tg-imports
TG_IMPORT_MAX_SIZE_MB=64
TG_IMPORT_ITEM_TIMEOUT=25
PYTHONDONTWRITEBYTECODE=1
