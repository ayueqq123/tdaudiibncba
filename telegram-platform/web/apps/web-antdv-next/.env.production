# 部署在宿主 nginx ggyzn1.top 的 /tg/ 子路径下:资源与 API 都带前缀,
# 宿主层剥掉 /tg/ 再转给容器 edge(:8443)
VITE_BASE=/tg/

# 接口地址(经宿主 /tg/ 前缀反代回 control-api)
VITE_GLOB_API_URL=/tg

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
